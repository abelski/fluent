DATABASE_URL=postgresql://user:pass@host/dbname
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your-random-secret-key-min-32-chars

# SMTP email sending (used by admin "mail user" feature)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Fluent <your-email@gmail.com>

# Stripe subscriptions (#11). All three must be set or /billing/config reports enabled:false.
# Price id and webhook secret are per-mode — swap them together with the secret key.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PRICE_ID=price_your-recurring-price-id
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Telegram admin notifications (feedback, reports, Stripe payment events #13).
# Unset ⇒ send_telegram() silently no-ops, so local dev works without them.
TELEGRAM_BOT_TOKEN=123456:your-botfather-token
TELEGRAM_CHAT_ID=your-admin-chat-id
